<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{{.Title}}</title>
  </head>
  <body>
  {{/* Ini adalah commentar */}}
    <h1>Hello {{.Name}}</h1>
   {{with .Address}}
    <h1> Address Region: {{.Region}} </h1>
    <h1> Address City: {{.City}}</h1>
   {{else}}
    <h1>Anda tidak punya alamat</h1>
   {{end}}
  </body>
</html>
